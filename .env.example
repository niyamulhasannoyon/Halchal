# ==============================================================================
# Halchal (হালচাল) - Environment Variables Configuration
# Architecture: ADR-0002, ADR-0004, ADR-0005, ADR-0007
#
# SECURITY DIRECTIVE:
# Never commit real credentials or .env files to Git.
# Secrets marked [SERVER ONLY] must NEVER be prefixed with NEXT_PUBLIC_ or exposed to clients.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Public Site URL (Technical SEO & Canonical Base)
# ------------------------------------------------------------------------------
# Production site URL used for canonical metadata, sitemap, and Open Graph URLs
NEXT_PUBLIC_SITE_URL=https://halchal.bd

# ------------------------------------------------------------------------------
# 1. Supabase Backend & Database Configuration
# ------------------------------------------------------------------------------
# Supabase project URL (Production project: halchal on ap-southeast-1)
SUPABASE_URL=https://jfllpmaljrprcomysvpc.supabase.co

# Modern publishable API key for frontend clients (recommended format)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_mkmz6p6J7RO9YOlAENTw6A_jLRSy9sA

# Legacy anonymous JWT key for backwards compatibility
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpmbGxwbWFsanJwcmNvbXlzdnBjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUwODU2NDMsImV4cCI6MjExMDY2MTY0M30.lWDHcoGzMtud-3xfV4k2azlMBaDTZv6DFguEHfOKZ3g

# [SERVER ONLY] Supabase service role key with full bypass RLS privileges for Edge Functions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# [SERVER ONLY] Secret used for verifying symmetric Supabase Auth JWT tokens
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets (HMAC & Pseudonymization)
# ------------------------------------------------------------------------------
# [SERVER ONLY] Secret key used to compute HMAC-SHA256(device_id) for privacy-preserving device hashing
DEVICE_SECRET=your-32-byte-hex-or-random-device-hashing-secret-salt

# [SERVER ONLY] Secret key used to cryptographically sign 15-minute one-tap restore vote action tokens
ACTION_TOKEN_SECRET=your-32-byte-action-token-signing-secret

# ------------------------------------------------------------------------------
# 3. Upstash Redis (Distributed Rate Limiting & Zone Cache)
# ------------------------------------------------------------------------------
# [SERVER ONLY] Upstash Redis REST endpoint for edge caching and rate limiting
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io

# [SERVER ONLY] Upstash Redis REST Bearer authentication token
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ------------------------------------------------------------------------------
# 4. Client Attestation Providers (Anti-Bot & Sybil Defense)
# ------------------------------------------------------------------------------
# Web: Cloudflare Turnstile public site key (used on Next.js PWA client)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAABBBBBBBBCCCCCC

# [SERVER ONLY] Cloudflare Turnstile secret key for server-side siteverify verification
TURNSTILE_SECRET_KEY=0x4AAAAAAABBBBBBBBCCCCCC_your_turnstile_secret_key

# Android: Google Play Integrity configuration
PLAY_INTEGRITY_PACKAGE_NAME=com.halchal.app

# [SERVER ONLY] Google Cloud Service Account OAuth token or credentials JSON for Play Integrity API
PLAY_INTEGRITY_SERVICE_ACCOUNT_TOKEN=ya29.your_google_cloud_oauth_bearer_token

# ------------------------------------------------------------------------------
# 5. Push Notifications (Web Push VAPID & Firebase FCM HTTP v1)
# ------------------------------------------------------------------------------
# VAPID Subject (mailto: or URL contact for push services)
VAPID_SUBJECT=mailto:notifications@halchal.bd

# Public VAPID key (exposed to client for PushManager.subscribe)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U

# [SERVER ONLY] Private VAPID key for signing RFC 8292 headers in notify-zone
VAPID_PRIVATE_KEY=your-private-vapid-key-here

# Firebase Cloud Messaging HTTP v1 (Flutter mobile push; strictly NOT legacy FCM API)
FIREBASE_PROJECT_ID=halchal-bd
FIREBASE_OAUTH_ACCESS_TOKEN=ya29.your_firebase_messaging_oauth_access_token

# ------------------------------------------------------------------------------
# 6. Testing & Local Development Flags
# ------------------------------------------------------------------------------
# Set to 'true' to enable in-memory mock attestation and mock auth bypass for automated test suites
HALCHAL_TEST_MODE=false
