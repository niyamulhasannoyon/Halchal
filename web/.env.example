# ==============================================================================
# Halchal Web (হালচাল ওয়েব) - Environment Variables Configuration
# Copy this file to .env.local for local Next.js development.
# On Vercel, add these keys in: Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public App URL & Metadata
# ------------------------------------------------------------------------------
# Production or preview URL used for canonical metadata and OG image URLs
NEXT_PUBLIC_SITE_URL=https://halchal.bd
NEXT_PUBLIC_APP_URL=https://halchal.vercel.app

# ------------------------------------------------------------------------------
# 2. Supabase Backend Connection
# ------------------------------------------------------------------------------
# Supabase project URL (Production project on ap-southeast-1 Singapore)
NEXT_PUBLIC_SUPABASE_URL=https://jfllpmaljrprcomysvpc.supabase.co
SUPABASE_URL=https://jfllpmaljrprcomysvpc.supabase.co

# Supabase Anonymous / Publishable API key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_mkmz6p6J7RO9YOlAENTw6A_jLRSy9sA
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpmbGxwbWFsanJwcmNvbXlzdnBjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUwODU2NDMsImV4cCI6MjExMDY2MTY0M30.lWDHcoGzMtud-3xfV4k2azlMBaDTZv6DFguEHfOKZ3g
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpmbGxwbWFsanJwcmNvbXlzdnBjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUwODU2NDMsImV4cCI6MjExMDY2MTY0M30.lWDHcoGzMtud-3xfV4k2azlMBaDTZv6DFguEHfOKZ3g

# [SERVER ONLY - NEVER PREFIX WITH NEXT_PUBLIC_]
# Modern Supabase Secret Key (or legacy service_role key) for Next.js Route Handlers (/api/report, /api/restore-vote)
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here

# ------------------------------------------------------------------------------
# 3. Upstash Redis (Distributed Rate Limiting & Zone Status Cache)
# ------------------------------------------------------------------------------
# [SERVER ONLY] Upstash Redis REST endpoint for hot H3 zone caching (60s TTL)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io

# [SERVER ONLY] Upstash Redis REST Bearer authentication token
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ------------------------------------------------------------------------------
# 4. Map & Vector Tile Styling
# ------------------------------------------------------------------------------
# Optional custom MapLibre vector style (defaults to CartoDB Dark Matter)
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# ------------------------------------------------------------------------------
# 5. Anti-Bot Protection (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# Public Turnstile widget site key for web report submission
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAABBBBBBBBCCCCCC

# [SERVER ONLY] Secret key for server-side siteverify verification
TURNSTILE_SECRET_KEY=0x4AAAAAAABBBBBBBBCCCCCC_your_turnstile_secret_key

# ------------------------------------------------------------------------------
# 6. Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
# Public VAPID key used by browser PushManager.subscribe
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U

# ------------------------------------------------------------------------------
# 7. Testing & Development Flags
# ------------------------------------------------------------------------------
# Set to 'true' to bypass external network calls during local UI preview
HALCHAL_TEST_MODE=false
